# Copy to .env.local and fill in. Never commit real values.

# Signs access tokens (native auth). At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
AUTH_SECRET=

# Supabase (database + image storage only — auth is the app's own).
# Project Settings > API: the project URL and the secret / service_role key.
SUPABASE_URL=
# Server-only. Never expose it or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Email — used to send password-reset codes. Choose ONE:
#  a) Any SMTP account. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=the address,
#     SMTP_PASSWORD=an "App password" (Google Account > Security > 2-Step Verification > App passwords).
#  b) Resend (resend.com): RESEND_API_KEY=re_…  (EMAIL_FROM must use a domain verified in Resend)
# With neither set, development prints the email in the `pnpm dev` terminal instead of sending it.
EMAIL_FROM="Albert Academy <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
